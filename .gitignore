# Visual Studio user files
.vs/
.vsconfig

# Rider / JetBrains
.idea/
Plugins/Developer/RiderLink
Re_ActRogueLike.uproject.DotSettings.user

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Debug Files
*.pdb

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# Project files generated by UE
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*/*
Plugins/*/Binaries/*
# Whitelist game dll to skip compilation for new users
!UnrealEditor-ActionRoguelike.dll

# Builds
Build/*
*.modules
Build/Windows/FileOpenOrder/*
# pso cache files
!Build/Windows/PipelineCaches/*
# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
!Build/*/PakBlacklist*.txt
# Don't ignore icon files in Build
!Build/**/*.ico

# Configuration files generated by the Editor
Saved/*
Config/HoloLens/HoloLensEngine.ini
Platforms/HoloLens/Config/HoloLensEngine.ini

# Compiled source files for the engine to use
Intermediate/*
Plugins/**/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*

# Project Content Folders - temporarily now
Content/

# Diversion application files
.diversion/
.dvignore
